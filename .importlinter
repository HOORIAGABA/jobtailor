# Enforces the layer rule in CI. This one file is what keeps two invariants
# true after six months of edits:
#
#   I3  one producer per fact class
#   I5  deterministic work is never done by an LLM
#
# `engine` and `domain` cannot import `agents` or `io`, so no matching,
# scoring, validation or application can quietly acquire a model call.
#
# Order matters and is easy to get wrong: `agents` sits ABOVE `io` because an
# agent uses the LLM client, not the other way round.

[importlinter]
root_packages =
    app
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    app.api
    app.pipeline
    app.agents
    app.io
    app.engine
    app.domain

[importlinter:contract:engine-is-deterministic]
name = engine and domain must never reach a model or the network
type = forbidden
source_modules =
    app.engine
    app.domain
forbidden_modules =
    app.io
    app.agents
    app.pipeline
    httpx
    requests
    google
    langchain_core
    langgraph
