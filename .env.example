# One environment file. No profile switches — the stack is identical in
# development and production (STACK.md, D-17).

# --- LLM (required) ----------------------------------------------------
# NO MODEL DEFAULT EXISTS IN SOURCE. This project has been broken twice by a
# provider retiring a model that was hardcoded (llama-3.1-70b-versatile was
# decommissioned; llama-3.1-8b-instant moved to Enterprise). Copy the current
# model id from your provider's model list and paste it here.
#
# Google AI Studio -> https://aistudio.google.com  (Flash models are free)
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45

# --- Database (required) -----------------------------------------------
# Neon free tier: https://neon.tech — no expiry. Use a separate branch for dev.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# --- Security (required) -----------------------------------------------
JWT_SECRET=
FERNET_KEY=              # Fernet.generate_key() — encrypts stored mail credentials
CONFIRM_TOKEN_SECRET=    # HMAC key binding the approved message to the send call

# --- Budget (I7) -------------------------------------------------------
MAX_LLM_CALLS_PER_RUN=7
MAX_TOKENS_PER_RUN=40000

# --- Optional ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback

CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
