# One environment file. No profile switches — the stack is identical in
# development and production (STACK.md, D-17).

# --- LLM (required) ----------------------------------------------------
# NO MODEL DEFAULT EXISTS IN SOURCE. This project has been broken twice by a
# provider retiring a model that was hardcoded (llama-3.1-70b-versatile was
# decommissioned; llama-3.1-8b-instant moved to Enterprise). Copy the current
# model id from your provider's model list and paste it here.
#
# Google AI Studio -> https://aistudio.google.com/apikey
#
# Use the API MODEL ID, not the display name shown in the console:
#   console shows   "Gemini 2.5 Flash Lite"
#   .env wants       gemini-2.5-flash-lite
# Lowercase, hyphenated, no spaces. Checked at startup.
#
# Free tiers are capped PER MINUTE and the cap differs per model
# (gemini-3.8-flash is 5/min). Check yours:
#   https://aistudio.google.com/rate-limit
# LLM_PROVIDER=google needs no base url. ANY other value is treated as an
# OpenAI-compatible endpoint and requires LLM_BASE_URL. Known-good bases:
#   openrouter   https://openrouter.ai/api/v1
#   groq         https://api.groq.com/openai/v1
#   cerebras     https://api.cerebras.ai/v1
#   together     https://api.together.xyz/v1
#   ollama       http://localhost:11434/v1     (no key needed)
#
# --- Running it locally (no rate limits at all) ------------------------
# Ollama is the strongest option for THIS pipeline, not a compromise. It
# supports grammar-constrained generation: the schema restricts the sampler
# token by token, so the model CANNOT emit malformed JSON. Every parse failure
# this project has hit — an empty `sections` list, a renamed field, a retry
# spent on a shape problem — becomes impossible rather than unlikely.
#
#   ollama pull qwen3.5:4b          # ~3.4GB  — plenty for extraction
#   ollama pull phi4-mini           # ~3GB    — best small instruction follower
#   ollama pull qwen3.5:9b          # ~6.6GB  — for the planner, if it fits
#
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3.5:4b
#   LLM_API_KEY=                    # not needed
#
# THE TRAP: Ollama chooses a context size from free VRAM and SILENTLY cuts any
# prompt longer than it. Its OpenAI-compatible endpoint has no field for this,
# so no client can raise it per request. A parse window plus this project's
# system prompt is ~2,200 tokens; too small a context eats half the resume with
# no error, and the only symptom is a parse that lost things.
#
#   OLLAMA_CONTEXT_LENGTH=8192 ollama serve    # the fix
#   ollama ps                                  # CONTEXT column = what loaded
#
# OLLAMA_NUM_CTX is not a variable Ollama reads. It does nothing.
#
# Check before running the pipeline:
#   python scripts/check_model.py

# --- Two models, split by what each stage needs ------------------------
# The six calls in a run are not equal work:
#
#   3 x parse    bulk transcription, one correct answer, easiest stage
#   1 x brief    read a posting
#   1 x planner  THE HARD ONE: nine operation variants, real judgment
#   1 x prose    write a few sentences
#
# Measured on llama3.1:8b locally: the parse produced a clean document, and
# the planner returned NINE output tokens — an empty list. It is not a big
# enough model for that call.
#
# This is also the answer to the free-tier problem rather than a workaround
# for it. The stage that needs MANY calls runs locally and unmetered; the
# stages that need a CAPABLE model need three calls per run, which fits in
# any free tier many times over. Gemini's 1,500 requests a day is ~500 runs.
#
#   LLM_PROVIDER=ollama                      # parse: local, free, unlimited
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1:8b
#
#   SMART_LLM_PROVIDER=google                # judgment: 3 calls a run
#   SMART_LLM_API_KEY=...
#   SMART_LLM_MODEL=gemini-2.5-flash-lite
#
# Any SMART_ field left empty falls back to its LLM_ counterpart, so setting
# only SMART_LLM_MODEL against the same provider works too. Leave them all
# empty and one model does everything, as before.
SMART_LLM_PROVIDER=
SMART_LLM_API_KEY=
SMART_LLM_MODEL=
SMART_LLM_BASE_URL=
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Free-tier limits, measured September 2026 -------------------------
# One complete run is ~6 calls and ~20k tokens (3 parse windows, then the
# brief, the plan and the prose). Divide the caps below by that.
#
#   Google AI Studio   gemini flash-lite   30 RPM  1500 RPD   1M TPM
#                      gemini flash        15 RPM  1500 RPD   1M TPM
#     -> ~250 complete runs a day. The roomiest, and not a reasoning model,
#        so it does not spend the output budget thinking.
#
#   Groq               gpt-oss-120b        30 RPM  1000 RPD   8K TPM  200K TPD
#     -> TPD is the binding limit: ~10 complete runs a day. 8K TPM is tight
#        enough that back-to-back calls will 429; the client honours the
#        provider's stated retry delay, so it paces itself.
#
#   Cerebras           gpt-oss-120b         5 RPM            1M TPD
#     -> ~50 runs a day, but 5 RPM means ~12s between calls.
#
#   OpenRouter :free                       50 requests/day (1000 with $10 credit)
#     -> ~8 runs a day. The weakest of the four.
#
# Limits change often. Check before blaming the code.

# --- Reasoning models --------------------------------------------------
# "low" | "medium" | "high". Sent only when set, because a provider that does
# not know the field may reject the request outright.
#
# Set this to "low" on any reasoning model (the gpt-oss family, anything with
# a -medium/-high suffix). Measured on one 7,660-character resume:
#
#   gpt-oss-120b-medium    15,320 tokens, JSON never finished
#   a non-reasoning model   2,312 tokens, parsed cleanly
#
# Extraction has exactly one correct answer. There is nothing there worth
# thinking about, and the thinking comes out of the same budget as the answer.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45

# --- Database (required) -----------------------------------------------
# Neon free tier: https://neon.tech — no expiry. Use a separate branch for dev.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# --- Security (required) -----------------------------------------------
# Generate all three at once:   python -m scripts.keys
#
# None of them has a default in source, and each refuses at the point of use
# rather than falling back. A shared default signing key is a signature anyone
# can forge; a shared default encryption key is plaintext with extra steps.
#
# Changing FERNET_KEY makes every stored Gmail refresh token unreadable and
# every user has to reconnect. Changing the other two signs everyone out, which
# is harmless.
JWT_SECRET=              # signs the session cookie (app/engine/authsession.py)
FERNET_KEY=              # encrypts Google refresh tokens at rest
CONFIRM_TOKEN_SECRET=    # HMAC binding the approved message to the send call

# --- Google sign-in and sending ----------------------------------------
# One OAuth client covers both. Console steps:
#
#   1  https://console.cloud.google.com/projectcreate  — name it jobtailor
#   2  APIs & Services -> Library -> enable "Gmail API"
#   3  APIs & Services -> OAuth consent screen
#        User type: External.  Publishing status stays "Testing".
#        Scopes: add ONLY .../auth/gmail.send
#        Test users: add your own Gmail address (up to 100)
#   4  APIs & Services -> Credentials -> Create credentials
#        -> OAuth client ID -> Web application
#        Authorised redirect URI, character for character:
#          http://localhost:8000/api/auth/google/callback
#        (a trailing slash is a redirect_uri_mismatch)
#   5  Copy the client id and secret below.
#
# WHILE IN TESTING MODE: refresh tokens expire after SEVEN DAYS, so "connect
# Gmail" has to be done again each week. That is Google's rule, not a bug here.
# Publishing removes it and needs verification, which for gmail.send (a
# *sensitive* scope) is a review, not a CASA security assessment. Adding ANY
# other Gmail scope — compose, readonly, modify, mail.google.com — makes the
# app *restricted*: CASA assessment, ~6 weeks, renewed annually. See
# app/io/google.py. Do not add a second Gmail scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where the browser lands after signing in. The API and the UI are different
# origins in development, so this cannot be a relative path.
FRONTEND_URL=http://localhost:3000

# --- Sending (S11) -----------------------------------------------------
# "console" renders the real RFC-5322 message, stores it on the run as a
# downloadable .eml, and dispatches NOTHING. It is the default on purpose:
# sending is the only irreversible action here, so a misconfiguration should
# mean "nothing happened", never "something went to a stranger".
#
#   console     writes the .eml, sends nothing        (default)
#   gmail_api   sends through the Gmail API as you    (needs the OAuth client
#                                                      above, and the person to
#                                                      connect Gmail at the
#                                                      approval step)
#
# A misspelling is refused with a 503 rather than falling back to console —
# falling back would leave you believing something had been sent.
MAIL_PROVIDER=console

# --- Budget (I7) -------------------------------------------------------
MAX_LLM_CALLS_PER_RUN=12
MAX_TOKENS_PER_RUN=40000

# --- Optional ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# The origins allowed to call this API with cookies. A wildcard is no longer
# possible: a browser refuses to send cookies to a wildcard origin, so a session
# cookie and `*` cannot both exist. This is the good direction for that trade.
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
