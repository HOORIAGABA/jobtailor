# --- Database ---
# Default: local SQLite file (zero setup, zero cost)
DATABASE_URL=sqlite:///./data/jobtailor.db
# To use Postgres (e.g. Supabase/Neon free tier) instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
JWT_SECRET=change-this-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Google OAuth (optional, for "Login with Google") ---
# Get these from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are required for the OAuth flow.
# GOOGLE_REDIRECT_URI defaults to http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- LLM Provider ---
# Supported: "groq", "openai_compatible"
# A real LLM provider is REQUIRED — the pipeline uses LLM calls for
# resume parsing, tailoring, review, and outreach message drafting.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-70b-versatile

# --- Email sending (optional, for Outreach Agent) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# --- Gmail API (recommended, password-free sending) ---
# Lets the app send email from the logged-in user's own Gmail via OAuth,
# so NO App Password is needed. Requires a Google Cloud project:
#   1. https://console.cloud.google.com -> create/select a project
#   2. Enable the "Gmail API" (APIs & Services > Library)
#   3. Create OAuth client ID -> type "Web application"
#   4. Authorized redirect URI must match GMAIL_REDIRECT_URI below
#   5. Add the "gmail.send" OAuth scope to the consent screen
#   6. Paste the client ID and secret below
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback
